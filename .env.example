# 复制为 .env 后按需修改
# cp .env.example .env

# 数据库连接串（必填）
# SQLite 文件数据库：路径相对于启动时的目录（systemd 里是 /opt/blog-api）
DATABASE_URL=sqlite:///./blog.db

# Redis 缓存（可选，不填自动降级走数据库，不影响使用）
# REDIS_URL=redis://localhost:6379/0

# 生产环境务必改成随机字符串，生成方式：
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

APP_TITLE=Blog API
APP_VERSION=0.1.0
